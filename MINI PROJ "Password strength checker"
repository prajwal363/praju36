import re
import sqlite3

# Connect to SQLite database
conn = sqlite3.connect("2passwords.db")
cursor = conn.cursor()

# Create a table to store passwords
cursor.execute('''
CREATE TABLE IF NOT EXISTS password_history (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    password TEXT NOT NULL,
    strength TEXT NOT NULL
)
''')

def check_password_strength(password):
    # Checking the basic criteria
    length_error = len(password) < 8
    uppercase_error = not any(char.isupper() for char in password)
    lowercase_error = not any(char.islower() for char in password)
    special_char_error = not bool(re.search(r"[!@#$%^&*(),.?\":{}|<>]", password))
    
    # Count the number of failed criteria
    errors = sum([length_error, uppercase_error, lowercase_error, special_char_error])
    
    # Strength Classification
    if errors == 0:
        strength = "High"
    elif errors == 1:
        strength = "Medium"
    else:
        strength = "Low"
    
    return strength, {
        "Length Error": length_error,
        "Uppercase Error": uppercase_error,
        "Lowercase Error": lowercase_error,
        "Special Character Error": special_char_error,
    }

def store_password(password, strength):
    cursor.execute('''
    INSERT INTO password_history (password, strength)
    VALUES (?, ?)
    ''', (password, strength))
    conn.commit()

def fetch_passwords():
    cursor.execute('''
    SELECT password, strength FROM password_history
    ''')
    rows = cursor.fetchall()
    for row in rows:
        print(f"Password: {row[0]}, Strength: {row[1]}")

def menu():
    while True:
        print("\nMenu:")
        print("1. Enter a new password")
        print("2. Display stored passwords")
        print("3. Exit")

        choice = input("Choose an option (1, 2, or 3): ")

        if choice == '1':
            password = input("Enter your password: ")
            strength, details = check_password_strength(password)
            store_password(password, strength)
            print(f"Password Strength: {strength}")
        elif choice == '2':
            print("\nStored Passwords:")
            fetch_passwords()
        elif choice == '3':
            conn.close()
            print("EXITED SUCCESFULLY")
            break
        else:
            print("Invalid choice. Please try again.")

# Start the menu
menu()
